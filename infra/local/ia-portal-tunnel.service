[Unit]
Description=IA-Portal private reverse SSH tunnel to existing HTTPS edge
Requires=ia-portal-stack.service
After=ia-portal-stack.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=ia-portal-tunnel
EnvironmentFile=/etc/ia-portal/tunnel/connection.env
ExecStart=/usr/bin/ssh -NT -i /etc/ia-portal/tunnel/id_ed25519 -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/ia-portal/tunnel/known_hosts -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ConnectTimeout=15 -R 127.0.0.1:19080:127.0.0.1:9080 -R 127.0.0.1:19089:127.0.0.1:9089 ${REMOTE_TARGET}
Restart=always
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/etc/ia-portal/tunnel

[Install]
WantedBy=multi-user.target
