FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish AiGateway.csproj -c Release -r linux-x64 --self-contained false -p:UseAppHost=false -o /out

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /out .
RUN mkdir -p /app/data && chown app:app /app/data
ENV ASPNETCORE_URLS=http://+:8080 DOTNET_GCServer=0
USER app
EXPOSE 8080
ENTRYPOINT ["dotnet","AiGateway.dll"]
