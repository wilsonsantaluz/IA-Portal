# Copie para .env e configure seus valores. Nunca publique este arquivo preenchido.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_ENABLED=true
DEEPSEEK_BASE_URL=https://api.deepseek.com/
DEEPSEEK_DEFAULT_MODEL=deepseek-chat
DEEPSEEK_MODELS=
DEEPSEEK_ALLOWED_ORIGINS=
OPENAI_ENABLED=false
OPENAI_BASE_URL=https://api.openai.com/v1/
OPENAI_DEFAULT_MODEL=gpt-4.1
OPENAI_MODELS=
OPENAI_ALLOWED_ORIGINS=
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434/
OLLAMA_DEFAULT_MODEL=
# Modelos Ollama devem corresponder aos instalados; nenhum modelo local e presumido.
OLLAMA_MODELS=
OLLAMA_API_KEY=
# Origens extras precisam ser autorizadas pelo responsavel no servidor (nao pela interface).
# Vazio: DeepSeek/OpenAI usam a origem de BASE_URL; Ollama usa localhost/host.docker.internal/ollama:11434.
OLLAMA_ALLOWED_ORIGINS=
OLLAMA_LOCAL_ORIGINS=
AI_DEFAULT_PROVIDER=deepseek
# Optional LiteLLM profile. Generate a random sk- prefixed master key locally.
LITELLM_ENABLED=false
LITELLM_MASTER_KEY=
LITELLM_BASE_URL=http://litellm:4000/v1/
LITELLM_ALLOWED_ORIGINS=http://litellm:4000
LITELLM_MODELS=fast,balanced,reasoning
LITELLM_DEFAULT_MODEL=fast
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Explicit per-route authorization, e.g. balanced. Empty forbids paid destinations.
LITELLM_PAID_ROUTES=
LITELLM_PAID_DAILY_BUDGET_USD=0
# Groq free tier requires an account restricted to its free quota (no paid billing).
LITELLM_GROQ_FREE_ACCOUNT=false
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_BALANCED_MODEL=openai/gpt-oss-120b
GROQ_REASONING_MODEL=openai/gpt-oss-120b
OPENROUTER_FREE_MODEL=openrouter/free
# Empty disables local deployment; models must already be installed.
LITELLM_OLLAMA_MODEL=
# HS256: use uma chave aleatoria de pelo menos 32 bytes (ex.: 64 caracteres hexadecimais).
JWT_KEY=
# Conta inicial: senha de pelo menos 12 caracteres. Usada somente em banco sem usuarios.
ADMIN_EMAIL=
ADMIN_PASSWORD=
USE_ADVANCED_RAG=false
# Dentro do container: backup consistente antes de evoluir o esquema SQLite existente.
# Manter em volume persistente, privado e fora do Git.
SQLITE_BACKUP_DIRECTORY=/app/data/backups
TRINO_URL=http://host.docker.internal:8081
TRINO_USER=portal
TRINO_CATALOG=memory
## Optional versioned LLM prices (JSON file in the gateway container; defaults to an empty list).
LLM_PRICES_FILE=config/model-prices.json

# Opt-in synthetic Atlas knowledge (never overwrites existing keys)
ATLAS_SEED_KNOWLEDGE=false
# Optional initial Atlas-only default; existing saved defaults are preserved.
ATLAS_AI_DEFAULT_PROVIDER=
ATLAS_AI_DEFAULT_MODEL=fast

# Cadastro publico exclusivamente na organizacao atlas-demo (HTTPS).
ATLAS_PUBLIC_SIGNUP=false
PORTAL_PUBLIC_URL=
SMTP_USERNAME=
# Senha de app do Google, nunca a senha principal da conta.
SMTP_APP_PASSWORD=
